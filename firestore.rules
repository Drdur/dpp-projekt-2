rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Provjera pripada li korisnik danom zakupcu (tenantId)
    function isTenantUser(tenantId) {
      return request.auth != null && request.auth.token.tenantId == tenantId;
    }

    // Provjera korisničke uloge (RBAC sukladno FprEN 18239)
    function hasRole(role) {
      return request.auth.token.role == role;
    }

    // Pravilo za izolaciju tvrtki i njihovih proizvoda
    match /tenants/{tenantId} {
      allow read, write: if isTenantUser(tenantId);
      
      match /products/{productId} {
        allow read, write: if isTenantUser(tenantId);
        
        match /passports/{passportId} {
          // Pisanje i izmjena dopušteni samo urednicima (editor/admin) te tvrtke
          allow write: if isTenantUser(tenantId) && (hasRole('editor') || hasRole('admin'));
          
          // JAVNI SLOJ: Svi mogu čitati putovnicu skeniranjem QR koda (EN 18222)
          allow read: if true; 
        }
      }
    }
  }
}